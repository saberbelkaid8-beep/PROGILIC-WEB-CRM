# ==============================================================================
# PROGILIC CRM v3 — Environment Configuration Template
# ==============================================================================

# --- AI Integration ---
# Required for Gemini AI extraction, analytical intelligence, and classification.
# Automatically injected at runtime in AI Studio or configured in Cloud Run.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Host & Deployment URL ---
# The canonical public URL where this application backend is hosted.
# Used for webhook callbacks, OAuth redirects, and self-referential links.
APP_URL="https://your-crm-domain.app"

# --- Google Cloud & Firebase Configuration ---
# Google Cloud project ID for Firebase Admin SDK and Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT="gen-lang-client-0400245577"

# Optional custom Firestore database ID (defaults to "(default)" if omitted).
FIRESTORE_DATABASE_ID="ai-studio-a76fe77b-fa2a-40a8-80e2-11da4bb068c7"

# --- Trello Operational Integration (Server-Side Only) ---
# Trello API Key and Token for server-side verification and REST synchronization.
# NEVER expose these credentials to browser code.
TRELLO_API_KEY="your_trello_api_key_here"
TRELLO_API_TOKEN="your_trello_member_token_here"

# Webhook signature secret for constant-time HMAC-SHA1 validation.
TRELLO_WEBHOOK_SECRET="your_trello_webhook_signing_secret"

# Exact callback URL registered with Trello webhook endpoint.
TRELLO_CALLBACK_URL="https://your-crm-domain.app/api/trello/webhook"

# Strict Scope Enforcement: Only cards and items within this board and list are processed.
TRELLO_BOARD_ID="your_authorized_trello_board_id"
TRELLO_LIST_ID="your_authorized_trello_list_id"

# Authorized Email: Strictly restricted to progilicservice@gmail.com
TRELLO_ALLOWED_EMAIL="progilicservice@gmail.com"

# Trusted Server-Side Tenant Mapping: The CRM tenant UID owning this board/list.
# Incoming webhooks are mapped to this tenant; client-supplied tenant IDs are strictly rejected.
TRELLO_TENANT_ID="your_authoritative_crm_tenant_uid"

# Optional Multi-Tenant JSON Mapping Table (overrides single-tenant configuration):
# Format: {"boardId::listId": "tenantUid"}
# TRELLO_TENANT_MAPPINGS='{"board123::list456": "tenant_abc", "board789::list012": "tenant_xyz"}'

# --- Production Safety Gate ---
# Set to 'true' to unlock live production synchronization with Trello and enable external write/webhook operations.
# Defaults to 'false' (fail-closed sandbox/dry-run mode).
TRELLO_PRODUCTION_GATE_UNLOCKED="false"

