+
+/* Beautiful Custom Microsoft-Style Tables */
+.premium-table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: right;
+  font-size: 13.5px;
+}
+
+.premium-table th {
+  padding: 12px 14px;
+  font-weight: 700;
+  color: var(--t2);
+  border-bottom: 2px solid var(--border);
