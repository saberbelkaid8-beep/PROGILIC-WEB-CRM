+    actionNature = 'installation';
+  } else if (/demande|ajouter|modifi|dÃ©veloppement|Ù…ÙŠØ²Ø©|ØªØ¹Ø¯ÙŠÙ„|Ø·Ù„Ø¨/i.test(clean)) {
+    actionNature = 'requirement';
+  } else if (/formation|explication|apprendre|guide|ØªØ¯Ø±ÙŠØ¨|Ø´Ø±Ø­/i.test(clean)) {
+    actionNature = 'training';
+  } else if (/Ø§Ø³ØªÙØ³Ø§Ø±|Ø³Ø¤Ø§Ù„|Ù…ØªØ§Ø¨Ø¹Ø©|ØªÙˆØ§ØµÙ„|contact|appel|question/i.test(clean)) {
+    actionNature = 'contact';
+  } else if (extractedInterventionMedium) {
+    actionNature = 'service';
+  } else {
+    uncertainties.push('Operational nature requires review');
+  }
+
+  // 5. Customer name extraction heuristic
+  let rawName = '';
+  const customerPrefixMatch = clean.match(/(?:client|Ø²Ø¨ÙˆÙ†|Ù„Ù„Ø²Ø¨ÙˆÙ†|Ù…Ø­Ù„|ets)\s+([A-Za-z\u0600-\u06FF0-9\s_-]+?)(?:[-â€“â€”:]|\s+(?:panne|install|vidÃ©o|dÃ©placement|0[5-7]|Ø³Ø·ÙŠÙ|ÙˆÙ‡Ø±Ø§Ù†|Ø§Ù„Ø¬Ø²Ø§Ø¦Ø±))/i);
+  if (customerPrefixMatch && customerPrefixMatch[1]) {
+    rawName = customerPrefixMatch[1].trim();
+  } else {
+    const parts = clean.split(/[-â€“â€”:]/);
+    if (parts.length > 1 && parts[0].trim().length >= 3) {
+      rawName = parts[0].replace(/(?:0|\+?213)[5-7]\d{8}/g, '').trim();
