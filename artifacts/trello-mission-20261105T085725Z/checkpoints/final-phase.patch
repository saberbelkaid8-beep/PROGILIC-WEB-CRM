+
+body.dark .dash-v-card:hover {
+  border-color: rgba(168, 85, 247, 0.45);
+  box-shadow: 0 16px 40px rgba(139, 92, 246, 0.18), 0 4px 16px rgba(0,0,0,0.3);
+}
+
+/* Micro-Glow Accents */
+.dash-glow-purple {
+  background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.08), transparent 70%);
+}
+.dash-glow-pink {
+  background: radial-gradient(circle at top right, rgba(236, 72, 153, 0.08), transparent 70%);
+}
+.dash-glow-blue {
+  background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.08), transparent 70%);
+}
+
+body.dark .dash-glow-purple {
+  background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.12), transparent 60%);
+}
+body.dark .dash-glow-pink {
+  background: radial-gradient(circle at top right, rgba(236, 72, 153, 0.12), transparent 60%);
+}
+body.dark .dash-glow-blue {
+  background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.12), transparent 60%);
+}
+
+/* Micro KPI Cards with Sparklines */
+.kpi-spark-container {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-end;
+  height: 55px;
+  margin-top: 0.5rem;
