+  width: 100%;
+}
+
+.auth-input-group input {
+  width: 100%;
+  padding: 16px 44px 16px 24px;
+  background: #ffffff;
+  border: 1px solid #e0e0e0;
+  border-radius: 100px; /* Fully rounded pill */
