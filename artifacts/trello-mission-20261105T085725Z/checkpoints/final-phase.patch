+.legend-dash i.ln{height:3px;width:18px;border-radius:2px;vertical-align:3px}
+
+.lrow{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border-soft);font-size:13.5px}
+.lrow:last-child{border-bottom:0}
+.lrow i{width:12px;height:12px;border-radius:3px}
+.lrow .n{margin-inline-start:auto;font-family:Inter;font-weight:700;direction:ltr;color:var(--t1)}
+.lrow .p{width:44px;text-align:end;color:var(--t3);font-family:Inter;font-size:12px;direction:ltr}
+
+.dash-item{display:flex;gap:14px;align-items:flex-start;padding:13px 0;border-bottom:1px solid var(--border-soft);cursor:pointer;transition:background .15s}
+.dash-item:hover{background:var(--border-soft);border-radius:8px;padding-inline-start:4px;padding-inline-end:4px}
+.dash-item:last-child{border-bottom:0;padding-bottom:0}.dash-item:first-child{padding-top:2px}
+.ico-dash{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;flex:none}
+.ico-dash.r{background:var(--rbg);color:var(--r)}.ico-dash.w{background:var(--wbg);color:var(--w)}.ico-dash.b{background:var(--bbg);color:var(--b)}.ico-dash.g{background:var(--gbg);color:var(--g)}.ico-dash.p{background:#F5F3FF;color:#7C3AED}
+.dash-item .tx b{font-size:13.5px;font-weight:700;display:block;line-height:1.4;color:var(--t1)}
