+.gi-sheet{background:var(--surface);border-radius:var(--r-lg) var(--r-lg) 0 0;width:100%;max-width:680px;max-height:90vh;overflow-y:auto;padding:1.25rem 1.5rem 2.5rem;animation:sheetUp .2s ease}
