+  border-color: #e0e0e0;
+  transform: translateY(-2px);
+}
+
+/* Right Image Area */
+.auth-right {
+  flex: 1.1; /* slightly larger than form */
+  border-radius: 40px;
+  overflow: hidden;
+  position: relative;
+  background: linear-gradient(135deg, #4A5CDA 0%, #0F1D7A 100%);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+/* Simulating the abstract purple/blue fluid background */
+.auth-bg-abstract {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background: 
+    radial-gradient(circle at 10% 20%, rgba(135, 100, 245, 0.8) 0%, transparent 55%),
+    radial-gradient(circle at 80% 80%, rgba(70, 90, 240, 0.9) 0%, transparent 65%),
+    radial-gradient(circle at 50% 120%, rgba(20, 20, 60, 0.95) 0%, transparent 70%),
+    radial-gradient(circle at 90% 10%, rgba(30, 50, 150, 0.8) 0%, transparent 50%);
+  filter: blur(25px);
+  transform: scale(1.1); /* Prevent blur edges from showing */
+}
+
+.auth-bg-wave {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background-image: url('data:image/svg+xml;utf8,<svg viewBox="0 0 800 1000" xmlns="http://www.w3.org/2000/svg"><path d="M0,400 C300,500 400,200 800,450 L800,1000 L0,1000 Z" fill="%23050a42"/><path d="M-100,0 C200,300 400,-100 800,200 L800,0 L0,0 Z" fill="%232c3fcf"/></svg>');
+  background-size: cover;
+  background-position: center;
+  opacity: 0.85;
+  mix-blend-mode: overlay;
+}
+
+.auth-right-logo {
+  position: relative;
+  z-index: 10;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
