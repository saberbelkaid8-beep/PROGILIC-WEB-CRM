+.c2{grid-column:span 2}.c3{grid-column:span 3}.c4{grid-column:span 4}.c6{grid-column:span 6}.c12{grid-column:span 12}
+@media(max-width:1200px){.c2,.c3,.c4,.c6{grid-column:span 12}}
+
+.chd{display:flex;align-items:flex-start;gap:12px;margin-bottom:16px}
+.chd h3{font-size:16px;font-weight:700;line-height:1.3;color:var(--t1)}
+.chd p{font-size:12px;color:var(--t3);margin-top:2px}
+.chd .act{margin-inline-start:auto;font-size:12px;font-weight:700;color:var(--brand-dark);display:flex;align-items:center;gap:4px;white-space:nowrap;cursor:pointer}
+
+.hb{display:grid;grid-template-columns:118px 1fr 46px;align-items:center;gap:12px;height:var(--rh,34px)}
+.hb .l{font-size:13px;color:var(--t2);font-weight:600;white-space:nowrap}
+.hb .t{height:12px;background:var(--border-soft);border-radius:6px;overflow:hidden;display:flex}
+.hb .f{height:100%;border-start-end-radius:4px;border-end-end-radius:4px;transition:width .4s ease}
+.hb .v{font-family:Inter;font-size:13px;font-weight:700;text-align:start;direction:ltr;justify-self:start;color:var(--t1)}
