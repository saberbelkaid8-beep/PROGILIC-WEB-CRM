+@media(max-width:520px){
+  .page{padding: 1rem 0.75rem}
+  .adv-fil-panel{grid-template-columns:1fr}
+  .gi-kpis{grid-template-columns:1fr 1fr}
+  .cgrid,.igrid{grid-template-columns:1fr}
+  .stats-row,.qstats{grid-template-columns:1fr 1fr}
+  .frow{grid-template-columns:1fr}
+  .score-card{flex-direction:column;align-items:center;text-align:center}
+  .sbar-lbl{width:70px;font-size:10px}
+  .fab{display:flex}
+  .hdr .btn-primary{display:none}
+  .report-kpis{grid-template-columns:1fr 1fr}
+  .prog-summary{grid-template-columns:1fr 1fr}
+  .hdr-ver{display:none}
+  
+  .stat-v{font-size:18px}
+  .mtitle{font-size:14px}
+  .msheet{padding: 1.25rem 1rem 2rem}
+}
+
+@media print{
+  .hdr,.back,.tabs-wrap,.dzone,.prog-acts,.ic-acts,.tl-acts,.ch-add-bar,.rep-print{display:none!important}
+  .tab-pane{border:none!important}
+  body{background:#fff}
+}
