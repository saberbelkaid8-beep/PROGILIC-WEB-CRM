+
+  // Extract common wilaya if present
+  let wilaya = null;
+  const wilayaMatch = clean.match(/(Ø³Ø·ÙŠÙ|ÙˆÙ‡Ø±Ø§Ù†|Ø§Ù„Ø¬Ø²Ø§Ø¦Ø±|Ù‚Ø³Ù†Ø·ÙŠÙ†Ø©|Ø¨ÙˆÙØ§Ø±ÙŠÙƒ|Ø¹Ù†Ø§Ø¨Ø©|ØªÙ„Ù…Ø³Ø§Ù†|Ø¨Ø§ØªÙ†Ø©|Ø§Ù„Ø¨Ù„ÙŠØ¯Ø©|Ø£Ø¯Ø±Ø§Ø±|Ø§Ù„Ø´Ù„Ù)/);
+  if (wilayaMatch) {
