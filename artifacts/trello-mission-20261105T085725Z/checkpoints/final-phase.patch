+
+/* â”€â”€ Business Profile Card â”€â”€ */
+.biz-profile{background:linear-gradient(135deg,var(--nav) 0%,var(--nav2,#1E3A5F) 100%);border-radius:var(--r-lg);padding:1rem 1.25rem;margin-bottom:10px;color:#fff;display:flex;align-items:center;gap:14px}
