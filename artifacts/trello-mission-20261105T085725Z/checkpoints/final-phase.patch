+.kpi .val b{font-size:32px;font-weight:800;letter-spacing:-.5px;line-height:1.1;font-family:Inter,Cairo,sans-serif}
+.kpi .val small{font-size:13px;color:var(--t3);font-weight:600}
+.kpi .row{display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
