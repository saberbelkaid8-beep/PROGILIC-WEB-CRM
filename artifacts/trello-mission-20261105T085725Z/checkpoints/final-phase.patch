+
+/* High Fidelity Cards (Apple Bento Grid Style) */
+.dash-v-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 22px;
+  padding: 1.5rem;
+  box-shadow: 0 4px 24px -2px rgba(0,0,0,0.03), 0 2px 8px -1px rgba(0,0,0,0.02);
+  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
