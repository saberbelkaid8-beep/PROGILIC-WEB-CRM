+  });
+
+  it('authorizes valid principal matching email, UID, and email_verified', () => {
+    expect(assertTrelloAuthorizedPrincipal(validToken, validEnv)).toBe(true);
+  });
+
+  it('fails closed when TRELLO_ALLOWED_EMAIL is missing or empty', () => {
