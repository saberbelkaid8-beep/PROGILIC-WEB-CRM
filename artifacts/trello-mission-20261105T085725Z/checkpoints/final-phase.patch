+}
+
+.copilot-chip:hover {
+  background: #ffffff;
+  border-color: #8B5CF6;
+  color: #6D28D9;
+  transform: translateY(-2px);
+  box-shadow: 0 6px 16px rgba(139, 92, 246, 0.15);
+}
+
+body.dark .copilot-chip {
+  background: rgba(255, 255, 255, 0.08);
+  border-color: rgba(255, 255, 255, 0.15);
+  color: #f1f5f9;
