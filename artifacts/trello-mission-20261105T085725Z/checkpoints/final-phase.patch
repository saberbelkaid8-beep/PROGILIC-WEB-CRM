+/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
+/* â”€â”€ CUSTOM MICROSOFT / APEXIFY / FINNOVA VIOLET THEME  â”€â”€ */
+/* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
+
+:root {
+  --dash-p: #8B5CF6; /* Violet */
+  --dash-p-light: #F5F3FF;
+  --dash-p-dark: #6D28D9;
+  --dash-p-glow: rgba(139, 92, 246, 0.12);
+  --dash-s: #EC4899; /* Pink */
+  --dash-s-glow: rgba(236, 72, 153, 0.1);
+  --dash-b: #3B82F6; /* Blue */
+  --dash-b-glow: rgba(59, 130, 246, 0.1);
+  --dash-g: #10B981; /* Green */
+  --dash-g-glow: rgba(16, 185, 129, 0.1);
+  --dash-r: #EF4444; /* Red */
+  --dash-r-glow: rgba(239, 68, 68, 0.1);
+}
+
+/* Base style resets and adaptations for custom premium dashboard */
+.dashboard-wrapper {
+  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
+  color: var(--t1);
+}
+
+body.dark .dashboard-wrapper {
+  color: var(--dm-t1);
+}
+
+/* â”€â”€ APPLE & MICROSOFT COPILOT DASHBOARD STYLES â”€â”€ */
+
+/* Copilot Hero Card */
+.copilot-hero {
+  position: relative;
+  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 50%, rgba(236, 72, 153, 0.06) 100%);
+  border: 1px solid rgba(139, 92, 246, 0.25);
+  border-radius: 24px;
+  padding: 1.5rem;
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+  box-shadow: 0 10px 30px -5px rgba(99, 102, 241, 0.1), 0 4px 12px rgba(0, 0, 0, 0.02);
+  overflow: hidden;
+  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+body.dark .copilot-hero {
+  background: linear-gradient(135deg, rgba(30, 27, 75, 0.6) 0%, rgba(88, 28, 135, 0.4) 50%, rgba(131, 24, 67, 0.3) 100%);
+  border-color: rgba(168, 85, 247, 0.35);
+  box-shadow: 0 12px 40px -5px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
+}
+
+.copilot-hero::before {
+  content: '';
+  position: absolute;
+  top: -50%;
+  left: -50%;
+  width: 200%;
+  height: 200%;
+  background: radial-gradient(circle at 30% 20%, rgba(99, 102, 241, 0.15), transparent 40%),
+              radial-gradient(circle at 70% 80%, rgba(236, 72, 153, 0.12), transparent 40%);
+  pointer-events: none;
+  animation: copilotMesh 12s ease-in-out infinite alternate;
+}
+
+@keyframes copilotMesh {
+  0% { transform: translate(0, 0) scale(1); }
+  100% { transform: translate(20px, 15px) scale(1.05); }
+}
+
+.copilot-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
