+/* â”€â”€ GPS Box â”€â”€ */
+.gps-row{display:flex;align-items:center;gap:8px;margin-top:8px;background:var(--bbg);border:1px solid #BFDBFE;border-radius:var(--r-sm);padding:.625rem .875rem}
