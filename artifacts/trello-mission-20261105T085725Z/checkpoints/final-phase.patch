+.delta.g{background:var(--gbg);color:var(--gt)}
+.delta.b{background:var(--rbg);color:var(--rt)}
+.kpi .sub{font-size:12px;color:var(--t3)}
+
+.grid-dash{display:grid;grid-template-columns:repeat(12,1fr);gap:20px}
