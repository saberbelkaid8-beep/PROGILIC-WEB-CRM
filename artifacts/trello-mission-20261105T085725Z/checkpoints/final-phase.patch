+
+.dept{display:flex;flex-direction:column;gap:10px;padding:18px 20px}
+.dept .h{display:flex;align-items:center;gap:10px;font-weight:700;font-size:14.5px;color:var(--t1)}
+.dept .big{font-family:Inter;font-size:30px;font-weight:800;line-height:1;letter-spacing:-.5px;color:var(--t1)}
+.dept .big small{font-family:Cairo;font-size:13px;font-weight:600;color:var(--t3);margin-inline-start:6px;letter-spacing:0}
+.dept .m{font-size:12px;color:var(--t3)}
+
+.dash-footer{margin-top:22px;display:flex;justify-content:space-between;color:var(--t3);font-size:12px}
+.sec-dash{font-size:11.5px;font-weight:700;color:var(--t3);letter-spacing:.2px;margin:0 0 10px}
+.hr-dash{height:1px;background:var(--border-soft);margin:14px 0}
