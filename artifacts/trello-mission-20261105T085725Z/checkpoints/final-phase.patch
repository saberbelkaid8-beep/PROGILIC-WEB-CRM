+.rep-action{display:flex;align-items:flex-start;gap:8px;background:var(--surface);border:1px solid var(--border);border-right:3px solid var(--brand);border-radius:var(--r-sm);padding:.625rem .875rem;margin-bottom:6px;font-size:12px;color:var(--t2)}
+.rep-action:last-child{margin-bottom:0}
+.rep-action.urgent{border-right-color:var(--r)}
+.rep-action.ok{border-right-color:var(--g)}
+.rep-action-icon{font-size:14px;flex-shrink:0}
+.rep-score-bar{display:flex;align-items:center;gap:8px;margin-bottom:6px}
+.rep-score-lbl{font-size:11px;color:var(--t2);width:100px;flex-shrink:0;text-align:right}
+.rep-score-track{flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden}
+.rep-score-fill{height:100%;border-radius:3px}
+.rep-score-val{font-size:11px;color:var(--t3);width:35px;text-align:left;flex-shrink:0;direction:ltr}
+.rep-risk-badge{display:inline-flex;align-items:center;gap:5px;padding:.375rem .75rem;border-radius:var(--r-sm);font-size:12px;font-weight:700;margin-bottom:.5rem}
+.rep-print{width:100%;margin-top:1rem}
