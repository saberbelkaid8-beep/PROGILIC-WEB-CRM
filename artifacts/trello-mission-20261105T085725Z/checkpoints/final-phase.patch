+/* ==========================================================================
+   15. Accessibility Fallbacks & System Modes
+   ========================================================================== */
+
+/* Fallback for browsers lacking backdrop-filter */
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
