+}
+
+.auth-wrapper * {
+  box-sizing: border-box;
+}
+
+.auth-card {
+  width: 100%;
+  max-width: 1000px;
+  min-height: 640px;
+  background: #ffffff;
+  border-radius: 48px;
+  display: flex;
+  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.15);
