+
+/* â”€â”€ Advanced Filter Panel â”€â”€ */
+.adv-fil-toggle{display:flex;align-items:center;gap:6px;padding:7px 12px;border-radius:var(--r-sm);border:1.5px solid var(--border);background:var(--surface);font-size:12px;font-weight:600;color:var(--t2);cursor:pointer;transition:all .14s;white-space:nowrap}
+.adv-fil-toggle:hover{border-color:#CBD5E1;color:var(--t1)}
