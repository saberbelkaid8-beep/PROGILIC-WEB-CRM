+  box-shadow: 0 0 0 3px rgba(28, 51, 166, 0.1);
+}
+
+.auth-input-group .input-icon {
+  position: absolute;
+  right: 20px;
+  top: 50%;
+  transform: translateY(-50%);
+  width: 18px;
+  height: 18px;
+  color: #888888;
+  pointer-events: none;
+}
+
+.auth-options {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-top: 4px;
+  margin-bottom: 16px;
+  font-size: 12px;
+}
+
+.auth-checkbox {
+  display: flex;
+  align-items: center;
+  color: #444;
+  cursor: pointer;
+  user-select: none;
+  font-weight: 500;
+}
+
+.auth-checkbox input {
+  position: absolute;
+  opacity: 0;
+  cursor: pointer;
+  height: 0;
+  width: 0;
+}
+
+.auth-checkbox .checkmark {
+  height: 16px;
+  width: 16px;
+  background-color: #fff;
+  border: 1px solid #c0c0c0;
+  border-radius: 4px;
+  margin-right: 8px;
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: all 0.2s;
+}
+
+.auth-checkbox:hover input ~ .checkmark {
+  border-color: #1C33A6;
+}
+
+.auth-checkbox input:checked ~ .checkmark {
+  background-color: #1C33A6;
+  border-color: #1C33A6;
+}
+
+.auth-checkbox .checkmark:after {
+  content: "";
+  position: absolute;
+  display: none;
+  width: 4px;
+  height: 8px;
+  border: solid white;
+  border-width: 0 2px 2px 0;
+  transform: rotate(45deg);
+  margin-bottom: 2px;
+}
+
+.auth-checkbox input:checked ~ .checkmark:after {
+  display: block;
+}
+
+.auth-forgot {
+  color: #888;
+  text-decoration: none;
+  font-weight: 500;
+  transition: color 0.2s;
+}
+
+.auth-forgot:hover {
+  color: #1C33A6;
+}
+
+.auth-btn {
+  width: 100%;
+  padding: 16px;
+  background: #2636C6; /* Match exact button color */
