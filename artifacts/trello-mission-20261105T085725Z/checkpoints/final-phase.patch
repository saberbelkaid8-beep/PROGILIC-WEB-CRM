+.adv-fil-panel{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r-lg);padding:.875rem;margin-bottom:.75rem;display:grid;grid-template-columns:1fr 1fr;gap:8px;animation:slideDown .15s ease}
