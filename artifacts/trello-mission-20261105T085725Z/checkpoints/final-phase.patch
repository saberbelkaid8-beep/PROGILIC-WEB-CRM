+        S.timelineCloudStatus = 'pending';
+        return;
+      }
+
+      const lastActivity = batch[batch.length - 1];
+    }
+    if (typeof localStorage !== 'undefined') {
+      try {
+        localStorage.setItem(`progilic_crm_activity_migration_${uid}`, 'complete');
+      } catch (_) {}
+    }
+  } catch (error) {
+    S.timelineCloudStatus = 'partial';
