{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific global settings, counter stats, and current sequence counter for offline ID generation",
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Database schema version (currently v3)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last global update"
        },
        "nid": {
          "type": "number",
          "description": "Next ID counter for generating unique client/sub-item IDs"
        },
        "stats": {
          "type": "object",
          "description": "Pre-aggregated counters for instant dashboard rendering",
          "properties": {
            "activeClients": { "type": "number" },
            "prospectiveClients": { "type": "number" },
            "stoppedClients": { "type": "number" },
            "totalClients": { "type": "number" },
            "totalPrograms": { "type": "number" },
            "totalLicensedDevices": { "type": "number" },
            "averageScore": { "type": "number" },
            "totalOpenIssues": { "type": "number" }
          }
        }
      },
      "required": ["v", "updatedAt", "nid"]
    },
    "Client": {
      "title": "Client Metadata",
      "description": "Independent client profile with denormalized analytics metrics for quick searches and grid listing",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric client ID for backward compatibility"
        },
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Client full name"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone number"
        },
        "gmailAccount": {
          "type": "string",
          "maxLength": 254,
          "description": "Client Gmail address"
        },
        "company": {
          "type": "string",
          "maxLength": 100,
          "description": "Company name"
        },
        "wilaya": {
          "type": "string",
          "maxLength": 50,
          "description": "Wilaya location in Algeria"
        },
        "commune": {
          "type": "string",
          "maxLength": 50,
          "description": "Commune / Municipality"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Client category (e.g. GC)"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "District or precise address"
        },
        "businessType": {
          "type": "string",
          "maxLength": 50,
          "description": "Main industry/business activity"
        },
        "businessField": {
          "type": "string",
          "maxLength": 50,
          "description": "Specific business sub-specialty"
        },
        "status": {
          "type": "string",
          "enum": ["نشط", "محتمل", "متوقف"],
          "description": "Client engagement status"
        },
        "startDate": {
          "type": "string",
          "description": "Contract start date (YYYY-MM-DD)"
        },
        "endDate": {
          "type": "string",
          "description": "Contract end date (YYYY-MM-DD)"
        },
        "lastContact": {
          "type": "string",
          "description": "Last touchpoint date (YYYY-MM-DD)"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "General notes on client relationship"
        },
        "gps": {
          "type": "object",
          "properties": {
            "lat": { "type": "string" },
            "lng": { "type": "string" }
          }
        },
        "score": {
          "type": "number",
          "description": "Calculated health score of client"
        },
        "openIssuesCount": {
          "type": "number",
          "description": "Denormalized count of unresolved issues"
        },
        "urgentIssuesCount": {
          "type": "number",
          "description": "Denormalized count of urgent unresolved issues"
        },
        "requirementsCount": {
          "type": "number",
          "description": "Denormalized count of feature requests"
        },
        "programsCount": {
          "type": "number",
          "description": "Denormalized count of licensed programs"
        },
        "installationsCount": {
          "type": "number",
          "description": "Denormalized count of licensed installations/devices"
        },
        "programNames": {
          "type": "array",
          "description": "Denormalized array of program display names"
        },
        "programs": {
          "type": "array",
          "description": "Denormalized summary array of licensed programs"
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency version counter"
        },
        "source": {
          "type": "string",
          "description": "Origin channel (online-crm, trello)"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server modification timestamp"
        }
      },
      "required": ["id", "fullName", "status"]
    },
    "Program": {
      "title": "Licensed Program",
      "description": "A software license assigned to a client",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "programName": { "type": "string", "maxLength": 200 },
        "platform": { "type": "string", "enum": ["Desktop", "Mobile", "Web", "Hybrid"] },
        "type": { "type": "string", "maxLength": 100 },
        "version": { "type": "string", "maxLength": 50 },
        "installationsCount": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1000 },
        "source": { "type": "string" },
        "trelloChecklistItemId": { "type": "string" },
        "lastModifiedBy": { "type": "string" }
      },
      "required": ["id", "programName", "platform", "type"]
    },
    "Issue": {
      "title": "Technical Issue",
      "description": "Customer bug ticket or technical support item",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["خطأ تقني", "أداء", "استفسار", "طلب ميزة", "خطأ مستخدم", "أخرى"] },
        "priority": { "type": "string", "enum": ["عاجل", "عالية", "متوسطة", "منخفضة"] },
        "status": { "type": "string", "enum": ["مفتوح", "قيد المعالجة", "محلول", "مغلق"] },
        "repeatCount": { "type": "number" },
        "featureOpp": { "type": "boolean" },
        "source": { "type": "string", "enum": ["نظام", "عميل", "سوء استخدام", "شبكة", "غير محدد"] },
        "confidence": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1000 },
        "solution": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "type", "priority", "status"]
    },
    "Requirement": {
      "title": "Feature Requirement",
      "description": "Custom development requests or functional requirements from the client",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string" },
        "priority": { "type": "string", "enum": ["عاجل", "عالية", "متوسطة", "منخفضة"] },
        "status": { "type": "string", "enum": ["مقترح", "قيد الدراسة", "مخطط", "منفذ", "مرفوض"] },
        "impact": { "type": "string", "enum": ["عالي", "متوسط", "منخفض"] },
        "date": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "priority", "status", "impact"]
    },
    "Contact": {
      "title": "Contact History Log",
      "description": "Historical interactions and meeting logs",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "date", "note"]
    },
    "Employee": {
      "title": "Employee Profile",
      "description": "PROGILIC staff member profile, department assignment, supervisor, and granular RBAC permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "enum": ["pre_vente", "commercial", "suivi", "technique"] },
        "position": { "type": "string", "maxLength": 100 },
        "supervisor": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "tasks": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["نشط", "معطل"] },
        "permissions": { "type": "object" }
      },
      "required": ["id", "fullName", "username", "department", "position", "status"]
    },
    "Activity": {
      "title": "Tenant Audit Activity",
      "description": "Immutable chronological audit log event across CRM modules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": ["number", "null"] },
        "clientName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "userName": { "type": "string", "maxLength": 100 },
        "userRole": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string", "maxLength": 254 },
        "source": { "type": "string", "maxLength": 20 },
        "meta": { "type": "object" }
      },
      "required": ["id", "clientId", "clientName", "type", "category", "title", "description", "timestamp", "userName", "userRole", "userId", "actorUid", "actorEmail", "source"]
    },
    "TrelloSync": {
      "title": "Trello Sync State",
      "description": "Distributed lease & idempotency record for Trello checklist items",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      },
      "required": ["itemId", "status", "updatedAt"]
    },
    "TrelloReview": {
      "title": "Trello Manual Review Queue Item",
      "description": "Low-confidence or ambiguous Trello checklist entry queued for manual operator resolution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "checklistItemId": { "type": "string", "maxLength": 128 },
        "rawText": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "checklistItemId", "rawText", "createdAt"]
    },
    "TestConnection": {
      "title": "Test Connection Document",
      "description": "Ping document to test connection status to Firestore backend",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User specific configuration, next sequence counter, and pre-calculated global stats"
    },
    "users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients belonging to this user"
    },
    "users/{userId}/clients/{clientId}/programs/{programId}": {
      "schema": "Program",
      "description": "Software products licensed to this client"
    },
    "users/{userId}/clients/{clientId}/issues/{issueId}": {
      "schema": "Issue",
      "description": "Technical support issues and bugs for this client"
    },
    "users/{userId}/clients/{clientId}/requirements/{requirementId}": {
      "schema": "Requirement",
      "description": "Functional feature requirements requested by this client"
    },
    "users/{userId}/clients/{clientId}/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Log of interactions with this client"
    },
    "users/{userId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Staff members, departments, and access control settings managed by the Gérant"
    },
    "users/{userId}/activities/{activityId}": {
      "schema": "Activity",
      "description": "Immutable shared tenant audit timeline"
    },
    "users/{userId}/trello_sync/{itemId}": {
      "schema": "TrelloSync",
      "description": "Trello integration idempotency and distributed lease mappings"
    },
    "users/{userId}/trello_review/{itemId}": {
      "schema": "TrelloReview",
      "description": "Trello items pending human operator review"
    },
    "test/{docId}": {
      "schema": "TestConnection",
      "description": "Public health check endpoint for testing Firestore connectivity"
    }
  }
}

