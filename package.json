{
  "name": "crm",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prebuild.js",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.js",
    "check:integrity": "npm audit && node scripts/dependency-check.js",
    "verify": "npm run check:integrity && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "algeria-locations": "^1.0.6",
    "firebase": "^12.16.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "puppeteer": "^25.3.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
